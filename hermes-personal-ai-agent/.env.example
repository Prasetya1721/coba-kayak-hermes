# =============================================================================
# Hermes Personal AI Agent - Environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Runtime ---
ENVIRONMENT=development            # development | production
DEBUG=true
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Postgres ---
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=hermes
DATABASE_URL=postgresql+asyncpg://hermes:change-me-strong-db-password@localhost:5432/hermes

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@localhost:6379/0

# --- JWT (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=change-me-48-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Field-level encryption (AES-256) fallback key ---
# Used when Vault is unavailable in dev. 32-byte key, base64 encoded.
# generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes

# --- Vault (KMS) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=hermes-dev-root
VAULT_MOUNT_POINT=secret
VAULT_PATH_PREFIX=hermes
# Set to true to require Vault (fail if unreachable). In dev, false falls back
# to FIELD_ENCRYPTION_KEY for local experiments only.
VAULT_REQUIRED=false

# --- AI Engine ---
# Provider: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Custom OpenAI-compatible endpoint (mis. https://modelrouter.id/v1). Kosongkan untuk OpenAI resmi.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_TEMPERATURE=0.2
# Short-term memory window (last N messages loaded per turn).
SHORT_TERM_MEMORY_SIZE=10

# --- LLM failover (anti-limit) ---
# Kalau model aktif kena limit/403/404/timeout, otomatis coba model berikutnya.
# Isi dengan model lain yang tersedia di gateway Anda, dipisah koma.
# Contoh: claude-sonnet-4.6,gemini-3.8-flash,deepseek-v4.1-flash
LLM_MODEL_FALLBACKS=
# Berapa lama model yang gagal dilewati (detik).
LLM_COOLDOWN_SECONDS=180
# Batas waktu & retry per request (detik).
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=1

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Public HTTPS URL used by Telegram to deliver webhooks.
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/webhooks/telegram
# Random string echoed back to Telegram to verify the webhook origin.
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# --- WhatsApp (choose a provider) ---
# Provider: twilio | baileys | none
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Baileys (self-hosted) gateway, used when WHATSAPP_PROVIDER=baileys
BAILEYS_GATEWAY_URL=http://localhost:3100
BAILEYS_GATEWAY_TOKEN=change-me-baileys-token

# --- Web Search ---
# Provider: tavily (gratis 1000/bln, tanpa kartu kredit — recommended)
#         | duckduckgo (tanpa key, sering diblokir) | serpapi | brave | none
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Device Management (SSH) ---
# Comma-separated command prefix whitelist enforced before executing SSH.
SSH_COMMAND_WHITELIST=uptime,df -h,free -m,systemctl status,systemctl restart,pm2 status,pm2 restart,docker ps,docker logs,git status,git pull,ls,cat
SSH_CONNECT_TIMEOUT_SECONDS=10
SSH_COMMAND_TIMEOUT_SECONDS=30

# --- Repo access (sandboxed, read-only) ---
# Folder yang boleh dibaca Stella (mis. repo PMS). Kosong = fitur mati.
# Contoh Windows: REPO_ROOTS=D:\projects\PMS
REPO_ROOTS=
REPO_MAX_FILE_BYTES=200000
REPO_MAX_OUTPUT_CHARS=12000
REPO_MAX_MATCHES=40

# --- Code execution (sandboxed, MATI secara default) ---
# Nyalakan hanya kalau kamu paham risikonya: kode jalan di server backend.
CODE_EXEC_ENABLED=false
CODE_EXEC_TIMEOUT_SECONDS=30
CODE_EXEC_MAX_OUTPUT_CHARS=8000
CODE_EXEC_LANGUAGES=python

# --- Web Management ---
# GITHUB_TOKEN: Personal Access Token (classic) dengan scope 'repo' untuk baca
# repo PRIVAT + push. Repo publik bisa dibaca tanpa token (rate limit lebih kecil).
# Bisa juga disimpan per-user lewat dashboard (service_name: github_token).
GITHUB_TOKEN=
VERCEL_TOKEN=

# --- Notification Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Jakarta
SCHEDULER_POLL_SECONDS=30

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
